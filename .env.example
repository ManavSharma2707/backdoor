# Copy to .env for local use. Never commit .env. All values here are placeholders.

# Backend
APP_ENV=local
# Host tools (pytest, alembic on your machine) use localhost. Compose overrides the host to db.
DATABASE_URL=postgresql+psycopg://backroom:backroom@localhost:5432/backroom
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2
# Set true only with a transaction pooler (Supabase port 6543).
DATABASE_TRANSACTION_POOLER=false
JWT_SECRET=replace-with-32-plus-random-bytes-base64
JWT_ISSUER=backroom
JWT_AUDIENCE=backroom-web
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
JOB_TOKEN=replace-with-32-plus-random-bytes-base64
ALLOW_REGISTRATION=false
DEMO_LOGIN_ENABLED=false
ALLOW_DEMO_RESET=false
SIMULATE_WEEKLY=false
AGENTS_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL_FAST=
GEMINI_MODEL_SMART=
GEMINI_EMBED_MODEL=
EMBED_DIM=768
LOG_LEVEL=INFO
# Seed only. 12 or more characters. Never committed.
DEMO_OWNER_PASSWORD=
SEED_BASE=20261011

# Frontend (Vite, build time)
VITE_API_BASE_URL=/api/v1
VITE_CHAT_DIRECT_URL=
VITE_APP_NAME=Backroom
